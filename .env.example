# GEMINI_API_KEY: Optional for AI API features if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for auth redirects and API callbacks).
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL / Supabase connection URI (Pooler or Direct connection)
# Required in production (Vercel / Cloud Run / Railway) for Drizzle ORM & persistent storage.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# SUPABASE_URL & SUPABASE_ANON_KEY: Public Supabase project URL and anonymous key (safe for RLS-protected queries)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# NOTE: Never expose SUPABASE_SERVICE_ROLE_KEY in VITE_ client variables.
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"
