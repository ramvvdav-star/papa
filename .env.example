# GEMINI_API_KEY: Optional/Required for AI question generation routes.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL of your deployed application
APP_URL="https://your-app.vercel.app"

# PostgreSQL Database Connection (Option A: Single connection string for Supabase / Neon / Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# PostgreSQL Database Connection (Option B: Individual Cloud SQL / PostgreSQL credentials)
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="your_password"
SQL_DB_NAME="postgres"
