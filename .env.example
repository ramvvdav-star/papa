# ==============================================================================
# NTA PULSE (JEE Main, JEE Advanced & NEET UG) — Environment Configuration
# Copy this file to .env for local development or configure in Vercel Settings
# ==============================================================================

# 1. PostgreSQL / Supabase Database Connection (Required for Persistence)
DATABASE_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
SUPABASE_DB_URL="postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 2. Supabase Authentication & Client SDK (Frontend VITE_ Prefixed)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 3. Server-Only Secrets (NEVER expose with VITE_ prefix)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SESSION_SECRET="replace-with-at-least-32-chars-cryptographic-random-secret"

# 4. Canonical Application URL (Used for OAuth & Password Reset Redirects)
APP_URL="https://vercel.app"

# 5. Demo Accounts Configuration (Optional)
ENABLE_DEMO_ACCOUNTS="true"
DEMO_ADMIN_PASSWORD="Admin@2026!"
DEMO_TEACHER_PASSWORD="Teacher@2026!"
DEMO_STUDENT_PASSWORD="Student@2026!"

# 6. Optional AI Integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
